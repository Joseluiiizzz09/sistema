{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Read(./**/credentials.json)",
      "Read(./**/service-account*.json)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)"
    ]
  }
}
